NODE_ENV=production
APP_URL=https://your-ravs-domain.example
SESSION_SECRET=replace-with-at-least-32-random-characters
# Public signup never grants ADMIN. See scripts/grant-admin.mjs.
WELCOME_CREDITS=100
GENERATION_RATE_LIMIT_PER_MINUTE=6

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public

HF_CREDENTIALS=KEY_ID:KEY_SECRET
# Or use HF_API_KEY_ID and HF_API_KEY_SECRET, server-only.
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai

# Wire.mn — reuse the same hosted-checkout pattern as socialtool.store
WIRE_MN_API_URL=https://api.wire.mn/v1
WIRE_MN_API_KEY=sk_test_REPLACE_ME
WIRE_MN_WEBHOOK_SECRET=whsec_REPLACE_ME
# Test key: sandbox. Live key: active operator ID(s), or leave empty to let Wire select connected operators.
WIRE_MN_ALLOWED_OPERATORS=sandbox
# Optional network hardening. Comma-separated source IPs. Wire webhook IP previously used: 65.109.117.186
WIRE_MN_WEBHOOK_ALLOWED_IPS=65.109.117.186

# Optional:
# CREDIT_PACKAGES_JSON=[{"id":"starter","name":"Starter","priceMnt":20000,"credits":2000}]
