generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum GenerationStatus {
  PENDING
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
  NSFW
  CANCELED
}

enum LedgerType {
  EXPIRY
  WELCOME
  GENERATION
  REFUND
  PURCHASE
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  role         Role           @default(USER)
  credits      Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  creditGrants CreditGrant[]
  generations  Generation[]
  ledger       CreditLedger[]
  payments     Payment[]
  oauthCodes   OAuthCode[]
  oauthGrants  OAuthGrant[]
  movieProjects MovieProject[]
}

model Generation {
  id                String           @id @default(cuid())
  userId            String
  providerRequestId String?          @unique
  externalRequestKey String?         @unique
  providerStatusUrl String?
  providerCancelUrl String?
  modelSlug         String
  modelId           String
  kind              String
  prompt            String
  input             Json
  output            Json?
  error             Json?
  status            GenerationStatus @default(PENDING)
  creditAllocation Json?
  costCredits       Int
  refunded          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  completedAt       DateTime?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model CreditLedger {
  id             String     @id @default(cuid())
  userId         String
  amount         Int
  type           LedgerType
  idempotencyKey String     @unique
  referenceId    String?
  metadata       Json?
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  userId       String
  provider     String        @default("wire")
  packageId    String
  validityMonths Int?
  amountMnt    Int
  credits      Int
  invoiceId    String?       @unique
  paymentId    String?       @unique
  status       PaymentStatus @default(PENDING)
  providerData Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  paidAt       DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OAuthClient {
  id String @id @default(cuid())
  name String
  redirectUris Json
  createdAt DateTime @default(now())
  codes OAuthCode[]
  grants OAuthGrant[]
}
model OAuthCode {
  id String @id @default(cuid())
  codeHash String @unique
  userId String
  clientId String
  redirectUri String
  challenge String
  resource String
  scope String
  expiresAt DateTime
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model OAuthGrant {
  id String @id @default(cuid())
  userId String
  clientId String
  resource String
  scope String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokens OAuthToken[]
  @@index([userId, revokedAt])
}
model OAuthToken {
  id String @id @default(cuid())
  accessHash String @unique
  refreshHash String? @unique
  grantId String
  accessExpiresAt DateTime
  refreshExpiresAt DateTime?
  revokedAt DateTime?
  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  @@index([grantId])
}

model CreditGrant {
  id String @id @default(cuid())
  userId String
  paymentId String @unique
  packageId String
  remaining Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model DemoVideo {
  id String @id @default(cuid())
  sourceMediaUrl String @unique
  videoUrl String
  sourceUrl String
  title String
  category String @default("effects")
  published Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([published, createdAt])
}

model MovieProject {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  requestKey      String
  requestHash     String
  prompt          String
  targetSeconds   Int
  aspectRatio     String
  resolution      String
  modelSlug       String
  qualityProfile  String       @default("cinematic")
  status          String       @default("QUEUED")
  maxCredits      Int
  quotedCredits   Int
  leaseUntil      DateTime?
  lastError       String?
  aiQaApproved    Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  scenes          MovieScene[]
  @@index([status, leaseUntil, createdAt])
  @@index([userId, createdAt])
  @@unique([userId, requestKey])
}

model MovieScene {
  id              String       @id @default(cuid())
  projectId       String
  project         MovieProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number          Int
  duration        Int
  prompt          String
  input           Json
  quotedCredits   Int
  status          String       @default("PENDING")
  generationId    String?
  attempts        Int          @default(0)
  lastError       String?
  qaStatus        String       @default("NOT_RUN")
  qaReport        Json?
  nextAttemptAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  attemptsLog     MovieGenerationAttempt[]
  @@unique([projectId, number])
  @@index([status, nextAttemptAt])
}

model MovieGenerationAttempt {
  id             String @id @default(cuid())
  sceneId        String
  scene          MovieScene @relation(fields:[sceneId],references:[id],onDelete:Cascade)
  attempt        Int
  generationId   String @unique
  quotedCredits  Int
  createdAt      DateTime @default(now())
  @@unique([sceneId, attempt])
}
