generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum GenerationStatus {
  PENDING
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
  NSFW
  CANCELED
}

enum LedgerType {
  WELCOME
  GENERATION
  REFUND
  PURCHASE
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  role         Role           @default(USER)
  credits      Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  generations  Generation[]
  ledger       CreditLedger[]
  payments     Payment[]
  oauthCodes   OAuthCode[]
  oauthGrants  OAuthGrant[]
}

model Generation {
  id                String           @id @default(cuid())
  userId            String
  providerRequestId String?          @unique
  externalRequestKey String?         @unique
  providerStatusUrl String?
  providerCancelUrl String?
  modelSlug         String
  modelId           String
  kind              String
  prompt            String
  input             Json
  output            Json?
  error             Json?
  status            GenerationStatus @default(PENDING)
  costCredits       Int
  refunded          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  completedAt       DateTime?
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model CreditLedger {
  id             String     @id @default(cuid())
  userId         String
  amount         Int
  type           LedgerType
  idempotencyKey String     @unique
  referenceId    String?
  metadata       Json?
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  userId       String
  provider     String        @default("wire")
  packageId    String
  amountMnt    Int
  credits      Int
  invoiceId    String?       @unique
  paymentId    String?       @unique
  status       PaymentStatus @default(PENDING)
  providerData Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  paidAt       DateTime?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OAuthClient {
  id String @id @default(cuid())
  name String
  redirectUris Json
  createdAt DateTime @default(now())
  codes OAuthCode[]
  grants OAuthGrant[]
}
model OAuthCode {
  id String @id @default(cuid())
  codeHash String @unique
  userId String
  clientId String
  redirectUri String
  challenge String
  resource String
  scope String
  expiresAt DateTime
  usedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model OAuthGrant {
  id String @id @default(cuid())
  userId String
  clientId String
  resource String
  scope String
  createdAt DateTime @default(now())
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokens OAuthToken[]
  @@index([userId, revokedAt])
}
model OAuthToken {
  id String @id @default(cuid())
  accessHash String @unique
  refreshHash String? @unique
  grantId String
  accessExpiresAt DateTime
  refreshExpiresAt DateTime?
  revokedAt DateTime?
  grant OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  @@index([grantId])
}
